# Токен доступа к сообществу ВКонтакте.
# Получить: Управление сообществом → Работа с API → Создать ключ.
# Требуемые права: "Сообщения сообщества", "Управление сообществом".
VK_TOKEN=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Строка подключения SQLAlchemy.
# По умолчанию — SQLite-файл в ./data/bot.db (путь вычисляется от корня проекта).
DB_URL=sqlite+aiosqlite:///./data/bot.db

# Таймаут HTTP-запросов к внешним API, в секундах.
API_TIMEOUT=15
